# Copy this file to .env and fill in your Supabase project values.
# Do NOT put your database password or service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_HCAPTCHA_SITE_KEY=YOUR_HCAPTCHA_SITE_KEY

# Optional: 高德 (Amap) JS API 2.0 key and its 安全密钥, for in-page 高德 route maps (Google is used without them).
VITE_AMAP_KEY=YOUR_AMAP_WEB_JS_API_KEY
VITE_AMAP_SECURITY_CODE=YOUR_AMAP_SECURITY_CODE
